{
    "name": "@courseroad/web",
    "version": "0.1.2",
    "private": true,
    "type": "module",
    "scripts": {
        "auth:gen": "bunx @better-auth/cli generate --config src/server/auth/auth.ts --yes",
        "build": "next build",
        "build:storybook": "storybook build",
        "build:webpack": "next build --webpack",
        "check": "bun run format:check && bun run lint:check && bun run type:check",
        "check:ci": "bun run format:check && bun run lint:ci && bun run type:check && bun run test:unit && bun run test:coverage",
        "clean": "rimraf .next out",
        "commitlint": "bunx commitlint --edit",
        "commitlint:check": "bunx commitlint --from HEAD~1 --to HEAD --verbose",
        "db:gen": "prisma generate",
        "db:mig": "prisma migrate dev",
        "db:mig:prod": "prisma migrate deploy",
        "db:push": "prisma db push",
        "db:push:force": "prisma db push --accept-data-loss",
        "db:reset": "prisma migrate reset && prisma db push --accept-data-loss",
        "db:studio": "prisma studio",
        "db:sync": "prisma db push && prisma generate",
        "dev": "next dev",
        "dev:webpack": "next dev --webpack",
        "fix": "bun run format && bun run lint",
        "format": "bunx --bun prettier --write --cache --cache-location .next/cache/.prettiercache .",
        "format:check": "bunx --bun prettier --check --cache --cache-location .next/cache/.prettiercache .",
        "knip": "bunx --bun knip",
        "lint": "bunx eslint --fix --cache --cache-location .next/cache/.eslintcache .",
        "lint:check": "bunx eslint --cache --cache-location .next/cache/.eslintcache .",
        "lint:ci": "bunx eslint --max-warnings 0 .",
        "start": "next start",
        "storybook": "storybook dev -p 6006",
        "taze": "bunx --bun taze -I",
        "taze:major": "bunx --bun taze major -I",
        "test:coverage": "vitest --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:ui": "vitest --ui",
        "test:unit": "vitest run --config vitest.unit.config.ts",
        "test:watch": "vitest --watch",
        "tunnel": "cloudflared tunnel run --url http://localhost:3000 courseroad-dev",
        "type:check": "bun node_modules/@typescript/native/bin/tsc --noEmit"
    },
